{
  "name": "verdant-voxel",
  "private": true,
  "version": "0.1.10007",
  "type": "module",
  "description": "VERDANT: именованные сохранения, поверхностные водоёмы, вода WebGPU и плавание",
  "scripts": {
    "dev": "node scripts/desktop-dev.mjs",
    "dev:browser": "node scripts/dev-entry.mjs",
    "dev:server": "vite --host 127.0.0.1 --strictPort",
    "build": "vite build",
    "desktop": "npm run dev",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "auto:update": "node scripts/auto-update.mjs",
    "watch:zip": "npm run auto:update",
    "update:status": "node scripts/update-status.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "postbuild": "node scripts/ci-browser-check.mjs"
  },
  "dependencies": { "three": "0.186.1", "electron-updater": "6.8.9" },
  "devDependencies": { "vite": "8.3.4", "electron": "44.7.0", "electron-builder": "26.15.3", "playwright": "1.56.1" },
  "engines": { "node": ">=22.12.0" },
  "main": "electron/main.cjs",
  "build": {
    "appId": "io.verdant.voxel",
    "productName": "VERDANT",
    "asar": true,
    "directories": { "output": "dist-release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": { "target": ["nsis"], "verifyUpdateCodeSignature": false },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "artifactName": "VERDANT-Setup-${version}.${ext}" },
    "publish": [{ "provider": "github", "owner": "Dmitrynest2012", "repo": "VERDANT", "releaseType": "release" }]
  }
}
